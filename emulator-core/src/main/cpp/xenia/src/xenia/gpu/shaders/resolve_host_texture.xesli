#ifndef XENIA_GPU_SHADERS_RESOLVE_HOST_TEXTURE_XESLI_
#define XENIA_GPU_SHADERS_RESOLVE_HOST_TEXTURE_XESLI_

// XE_RESOLVE_HOST_TEXTURE: the direct host resolve also stores the 4 texels of
// its thread straight into the destination texture, viewed as raw uints (the
// R32_UINT alias of a 32-bit format), so the upload that would read the same
// bytes back from guest memory can be skipped. The texels are the values the
// upload would produce: the packed pixels before the endian swap of guest
// memory (the texture must have the same endianness as the resolve).
#if XE_RESOLVE_HOST_TEXTURE
  #if !SHADING_LANGUAGE_GLSL_XE || defined(XE_RESOLVE_RESOLUTION_SCALED)
    #error Direct host resolves into textures are unscaled SPIR-V only.
  #endif

  #if XE_RESOLVE_HOST_TEXTURE_R11G11B10
// k_10_11_11 destinations: the upload expands the packed pixels to 16 bits per
// component, so the texture is stored that expansion, through the R32G32_UINT
// alias of its R16G16B16A16_UNORM image.
layout(set = 3, binding = 0, rg32ui) uniform writeonly uimage2D
    xe_resolve_host_texture;
  #else
layout(set = 3, binding = 0, r32ui) uniform writeonly uimage2D
    xe_resolve_host_texture;
  #endif

// Stores the texels at origin + pixel_index + (0...3, 0), none outside the
// texture (a strip may overhang it).
void XeResolveHostTextureStore4(int2_xe origin, uint2_xe pixel_index,
                                uint4_xe texels) {
  int2_xe size = imageSize(xe_resolve_host_texture);
  int2_xe position = origin + int2_xe(pixel_index);
  if (position.y < 0 || position.y >= size.y) {
    return;
  }
  #if XE_RESOLVE_HOST_TEXTURE_R11G11B10
  // The RG and BA dwords of texels 0 and 1, then of texels 2 and 3.
  uint4_xe expanded_01 = XeR11G11B10UNormToRGBA16(texels.xy);
  uint4_xe expanded_23 = XeR11G11B10UNormToRGBA16(texels.zw);
  #endif
  for (int i = 0; i < 4; ++i) {
    int x = position.x + i;
    if (x >= 0 && x < size.x) {
  #if XE_RESOLVE_HOST_TEXTURE_R11G11B10
      uint4_xe expanded = i < 2 ? expanded_01 : expanded_23;
      imageStore(xe_resolve_host_texture, int2_xe(x, position.y),
                 uint4_xe((i & 1) != 0 ? expanded.zw : expanded.xy, 0u, 0u));
  #else
      imageStore(xe_resolve_host_texture, int2_xe(x, position.y),
                 uint4_xe(texels[i], 0u, 0u, 0u));
  #endif
    }
  }
}
#endif

#endif  // XENIA_GPU_SHADERS_RESOLVE_HOST_TEXTURE_XESLI_
