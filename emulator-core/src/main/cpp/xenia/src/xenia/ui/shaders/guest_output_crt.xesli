// XenDroid (15m): a CRT look as a guest output effect, written for XenDroid. One pass from the
// guest output to the screen at any size: the picture filtered bilinearly, then scanlines and a
// soft darkening toward the corners.
// - The scanlines are a whole number of screen pixels apart (about 360 lines whatever the size,
//   never closer than 2 pixels), so they cannot beat against the screen's own rows the way lines
//   tied to the game's rows would at a fractional scale. Each line has its dark gap at the top.
// - Like a CRT beam that blooms, the gaps are shallower over bright content, so highlights keep
//   most of their light.
// - No curvature and no phosphor mask: phone panels have their own subpixel layouts, which a
//   fine color mask would beat against.
// The push constants are SGSR's layout (the last float is unused here).

#include "xesl.xesli"

#ifdef XE_GUEST_OUTPUT_DITHER
  #include "dither_8bpc.xesli"
#endif  // XE_GUEST_OUTPUT_DITHER

push_const_begin_xe(b0, space0)
  // 16 used by the vertex shader (GLSL push constant offsets are across
  // stages).
  block_offset_member_xe(16, c0.x, int2_xe, xe_crt_output_offset)
  block_offset_member_xe(24, c0.z, float2_xe, xe_crt_output_size_inv)
  // 1 / input width, 1 / input height, input width, input height.
  block_offset_member_xe(32, c1, float4_xe, xe_crt_input_info)
push_const_end_xe

// About this many lines from top to bottom, rounded to whole screen pixels per line.
#define XE_CRT_LINES 360.0f
// How dark a gap gets over black, and how much of that bright content takes away.
#define XE_CRT_GAP_DEPTH 0.4f
#define XE_CRT_GAP_BLOOM 0.6f
// How much the corners darken.
#define XE_CRT_VIGNETTE 0.15f

entry_outputs_begin_xe
  entry_out_target_xe(float4_xe, xe_crt_color, 0)
entry_outputs_end_stage_inputs_begin_xe
entry_stage_inputs_end_bindings_begin_pixel_xe
  push_const_binding_xe(buffer(0))
  entry_binding_next_xe
  texture_xe(texture_2d_xe, xe_crt_source, 0, 0, t0, space0, texture(0))
entry_bindings_end_inputs_begin_xe
  entry_in_pixel_coord_xe
entry_inputs_end_code_begin_xe
{
  uint2_xe pixel_coord = uint2_xe(int2_xe(in_pixel_coord_xe.xy) -
                                  push_const_xe(xe_crt_output_offset));
  float2_xe output_size_inv = push_const_xe(xe_crt_output_size_inv);
  float4_xe input_info = push_const_xe(xe_crt_input_info);

  // The picture: the four texels around the output pixel's center, filtered
  // bilinearly (texel centers at .5).
  float2_xe position = (float2_xe(pixel_coord) + 0.5f) * output_size_inv *
                           input_info.zw -
                       0.5f;
  float2_xe base = floor(position);
  float2_xe fraction = position - base;
  int2_xe last = int2_xe(input_info.zw) - int2_xe(1, 1);
  int2_xe texel = int2_xe(base);
  float3_xe top_left = texel_fetch_2d_xe(
      xe_crt_source, clamp(texel, int2_xe(0, 0), last), 0).rgb;
  float3_xe top_right = texel_fetch_2d_xe(
      xe_crt_source, clamp(texel + int2_xe(1, 0), int2_xe(0, 0), last), 0).rgb;
  float3_xe bottom_left = texel_fetch_2d_xe(
      xe_crt_source, clamp(texel + int2_xe(0, 1), int2_xe(0, 0), last), 0).rgb;
  float3_xe bottom_right = texel_fetch_2d_xe(
      xe_crt_source, clamp(texel + int2_xe(1, 1), int2_xe(0, 0), last), 0).rgb;
  float3_xe top = top_left + (top_right - top_left) * fraction.x;
  float3_xe bottom = bottom_left + (bottom_right - bottom_left) * fraction.x;
  float3_xe picture = top + (bottom - top) * fraction.y;

  // The scanlines: a raised cosine over each line, 0 on its first row.
  float output_height = 1.0f / output_size_inv.y;
  uint period = uint(max(2.0f, floor(output_height / XE_CRT_LINES + 0.5f)));
  float phase = float(pixel_coord.y % period) / float(period);
  float beam = 0.5f - 0.5f * cos(6.28318531f * phase);
  float luma = dot(picture, float3_xe(0.2126f, 0.7152f, 0.0722f));
  float depth = XE_CRT_GAP_DEPTH * (1.0f - XE_CRT_GAP_BLOOM * luma);
  picture *= 1.0f - depth * (1.0f - beam);

  // The corners: 1 in the middle of the picture, 1 - XE_CRT_VIGNETTE in them.
  float2_xe centered =
      (float2_xe(pixel_coord) + 0.5f) * output_size_inv * 2.0f - 1.0f;
  float corner = dot(centered, centered) * 0.5f;
  picture *= 1.0f - XE_CRT_VIGNETTE * corner * corner;

  float4_xe color;
  color.rgb = picture;
  #ifdef XE_GUEST_OUTPUT_DITHER
    // Clamping because on Vulkan, the surface may specify any format, including
    // floating-point.
    color.rgb = saturate_xe(color.rgb + XeDitherOffset8bpc(pixel_coord));
  #endif  // XE_GUEST_OUTPUT_DITHER
  color.a = 1.0f;
  out_xe(xe_crt_color) = color;
}
entry_code_end_xe
