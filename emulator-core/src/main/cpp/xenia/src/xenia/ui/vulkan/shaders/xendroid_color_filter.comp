#version 450
// Optional stylistic SDR adjustments, independent of game HUD or Android overlays.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) readonly uniform image2D source_image;
layout(set = 0, binding = 1, rgba8) writeonly uniform image2D destination_image;
layout(push_constant) uniform Filter { int mode; } options;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(destination_image)))) return;
    vec4 source = imageLoad(source_image, pixel);
    vec3 color = source.rgb;
    if (options.mode == 1) color = vec3(dot(color, vec3(0.2126, 0.7152, 0.0722)));
    if (options.mode == 2) color = (color - 0.5) * 1.12 + 0.5;
    if (options.mode == 3) color *= vec3(1.04, 1.0, 0.92);
    imageStore(destination_image, pixel, vec4(clamp(color, 0.0, 1.0), source.a));
}
