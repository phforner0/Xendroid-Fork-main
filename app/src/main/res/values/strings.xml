    <string name="set_framerate_limit">Frame rate limit</string>
    <string name="set_framerate_limit_desc">Caps how many frames the emulator presents per second. The console never went above 60, so frames beyond your screen\'s refresh are just heat and battery. Unlimited lets it run as fast as it can</string>
    <string name="set_refresh_cap">Cap guest display refresh (VSync)</string>
    <string name="set_refresh_cap_desc">Cap vblanks at the console\'s 50/60Hz rate; off lets the game run as fast as possible</string>
    <string name="set_scale_x">Resolution scale, width (real)</string>
    <string name="set_scale_x_desc">The real resolution scale: renders the game at this multiple of its native width. Whole steps only, and it cannot go below 1x. Costs GPU time and memory</string>
    <string name="set_scale_y">Resolution scale, height (real)</string>
    <string name="set_scale_y_desc">The real resolution scale: renders the game at this multiple of its native height. Whole steps only, and it cannot go below 1x. Costs GPU time and memory</string>
    <string name="set_scaling">Scaling &amp; sharpening</string>
    <string name="set_scaling_desc">Upscaling filter for the final image, from plain bilinear to AMD CAS sharpening or FSR upscaling</string>
    <string name="set_antialiasing">Antialiasing</string>
    <string name="set_antialiasing_desc">Apply FXAA post-process anti-aliasing to smooth edges; recommended when CAS or FSR is active</string>
    <string name="set_letterbox">Present letterbox</string>
    <string name="set_letterbox_desc">Keep the game\'s aspect ratio by adding black bars instead of stretching to fill the screen</string>
    <string name="set_widescreen">Widescreen</string>
    <string name="set_widescreen_desc">Reports a 16:9 display to games instead of 4:3, controlling their aspect ratio</string>
    <string name="set_display_mode">Display mode reported to game</string>
    <string name="set_display_mode_desc">Not a scaler: it only tells the game what the TV is. Most titles render at a fixed size and ignore it, so the picture usually will not change. For higher detail use Resolution scale under GPU</string>
    <string name="set_driver">Custom Vulkan driver</string>
    <string name="set_driver_desc">Path to a custom Vulkan driver library (e.g. Turnip) to load instead of the system driver</string>
