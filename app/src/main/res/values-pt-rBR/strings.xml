    <string name="set_framerate_limit">Limite de FPS</string>
    <string name="set_framerate_limit_desc">Limita quantos quadros por segundo o emulador mostra. O console nunca passou de 60, então quadros além da atualização da tela são só calor e bateria. Sem limite deixa rodar o mais rápido possível</string>
    <string name="set_refresh_cap">Limitar a atualização de tela do jogo (VSync)</string>
    <string name="set_refresh_cap_desc">Limita os vblanks à taxa de 50/60 Hz do console; desligado deixa o jogo rodar o mais rápido possível</string>
    <string name="set_scale_x">Escala de resolução, largura (real)</string>
    <string name="set_scale_x_desc">A escala de resolução real: desenha o jogo neste múltiplo da largura nativa. Só passos inteiros, e não fica abaixo de 1x. Custa tempo de GPU e memória</string>
    <string name="set_scale_y">Escala de resolução, altura (real)</string>
    <string name="set_scale_y_desc">A escala de resolução real: desenha o jogo neste múltiplo da altura nativa. Só passos inteiros, e não fica abaixo de 1x. Custa tempo de GPU e memória</string>
    <string name="set_scaling">Escala e nitidez</string>
    <string name="set_scaling_desc">Filtro de ampliação da imagem final, do bilinear simples à nitidez AMD CAS ou à ampliação FSR</string>
    <string name="set_antialiasing">Antisserrilhado</string>
    <string name="set_antialiasing_desc">Aplica o antisserrilhado FXAA de pós-processamento para suavizar bordas; recomendado com CAS ou FSR ativos</string>
    <string name="set_letterbox">Barras pretas (letterbox)</string>
    <string name="set_letterbox_desc">Mantém a proporção do jogo com barras pretas em vez de esticar para preencher a tela</string>
    <string name="set_widescreen">Tela larga (widescreen)</string>
    <string name="set_widescreen_desc">Informa aos jogos uma tela 16:9 em vez de 4:3, o que define a proporção deles</string>
    <string name="set_display_mode">Modo de vídeo informado ao jogo</string>
    <string name="set_display_mode_desc">Não é um ampliador: só diz ao jogo qual é a TV. A maioria dos títulos desenha num tamanho fixo e ignora isso, então a imagem normalmente não muda. Para mais detalhe use a Escala de resolução, em GPU</string>
    <string name="set_driver">Driver Vulkan personalizado</string>
    <string name="set_driver_desc">Caminho de uma biblioteca de driver Vulkan personalizada (por exemplo Turnip) para carregar no lugar do driver do sistema</string>
    <string name="set_touch_overlay">Mostrar controle na tela</string>
    <string name="set_touch_overlay_desc">Desenha o controle na tela durante o jogo. Começa desligado se havia um controle físico ligado na primeira abertura, e ligado se não havia</string>
    <string name="set_soft_keyboard">Teclado do Android para texto do jogo</string>
    <string name="set_soft_keyboard_desc">Abre o teclado do Android quando o jogo pede para digitar (gamertags, nomes de save). Desligado, o jogo recebe o próprio texto padrão</string>
    <string name="set_message_box">Diálogo do Android para mensagens do jogo</string>
    <string name="set_message_box_desc">Mostra as perguntas do próprio jogo (entrada no Xbox LIVE, confirmações de save) num diálogo que você responde. Desligado, o jogo recebe o botão que ele já tinha selecionado</string>
    <string name="set_achievements">Mostrar notificação de conquista</string>
    <string name="set_achievements_desc">Mostra um aviso na tela quando você desbloqueia uma conquista</string>
